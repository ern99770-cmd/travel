{
  "services": [
    {
      "name": "travel-mysql",
      "template": "mysql",
      "version": "8.0"
    },
    {
      "name": "travel-redis",
      "template": "redis"
    },
    {
      "name": "travel-server",
      "template": "java",
      "dependsOn": [
        "travel-mysql",
        "travel-redis"
      ],
      "rootDir": "travel-server",
      "buildCommand": "mvn clean package -DskipTests",
      "outputDir": "travel-server/target",
      "startCommand": "java -jar travel-0.0.1-SNAPSHOT.jar",
      "env": {
        "SPRING_PROFILES_ACTIVE": "prod",
        "MYSQL_HOST": "travel-mysql.zeabur.internal",
        "MYSQL_PORT": "3306",
        "MYSQL_USERNAME": "root",
        "REDIS_HOST": "travel-redis.zeabur.internal",
        "REDIS_PORT": "6379"
      }
    },
    {
      "name": "travel-front",
      "template": "node",
      "dependsOn": [
        "travel-server"
      ],
      "rootDir": "travel-front",
      "buildCommand": "npm install && npm run build",
      "outputDir": "travel-front/dist",
      "framework": "static"
    },
    {
      "name": "travel-admin",
      "template": "node",
      "dependsOn": [
        "travel-server"
      ],
      "rootDir": "travel-front-manage",
      "buildCommand": "npm install && npm run build",
      "outputDir": "travel-front-manage/dist",
      "framework": "static"
    }
  ]
}
